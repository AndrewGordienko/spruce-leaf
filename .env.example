# Direct OpenAI Responses API inference is the default. Terra handles substantive
# sales work, Luna handles lightweight routing, and the isolated outreach writer
# defaults to Sol. `--model gpt-5.6-sol` still applies Sol to every substantive stage.
OPENAI_API_KEY=
# SPRUCE_OPENAI_MODEL=gpt-5.6-terra
# SPRUCE_OPENAI_FAST_MODEL=gpt-5.6-luna
# SPRUCE_OPENAI_REASONING_EFFORT=low
# SPRUCE_OPENAI_FAST_REASONING_EFFORT=none
# Optional outreach lane overrides. By default Sol writes while the selected
# model independently edits and verifies it.
# SPRUCE_OPENAI_WRITER_MODEL=gpt-5.6-sol
# SPRUCE_OPENAI_WRITER_REASONING_EFFORT=high
# SPRUCE_OPENAI_EDITOR_MODEL=gpt-5.6-terra
# SPRUCE_OPENAI_EDITOR_REASONING_EFFORT=medium
# SPRUCE_OPENAI_VERIFIER_MODEL=gpt-5.6-terra
# SPRUCE_OPENAI_VERIFIER_REASONING_EFFORT=high
# SPRUCE_FOLD_OUTREACH_PLANNER=0
# Optional global override; otherwise Spruce Leaf applies smaller stage-specific caps.
# SPRUCE_OPENAI_MAX_OUTPUT_TOKENS=
# Standard is the predictable cost/latency default. `flex` is half-price but
# slower; `fast` is lower-latency at 2x token prices.
# SPRUCE_OPENAI_SERVICE_TIER=default
# Optional OpenAI-compatible test/proxy endpoint (default: https://api.openai.com/v1).
# SPRUCE_OPENAI_BASE_URL=

# The authenticated Claude, Codex, and Grok CLIs remain selectable with
# `--backend` or `/model`. Claude subscription auth notes follow.
#
# HEADLESS / CLOUD auth: on a server with no browser, authenticate the Claude
# subscription once with `claude setup-token` (run on any machine that HAS a
# browser) and paste the printed one-year token below so the daemon can reason
# unattended. Leave unset on your laptop, where the CLI is already logged in.
# Do NOT also set ANTHROPIC_API_KEY — it overrides the subscription and bills
# per token. The token expires after ~1 year; rotate it before then.
# CLAUDE_CODE_OAUTH_TOKEN=
#
# PREREQUISITES for a large sourced motion (planning activates one primary
# contact per account, even when more identities are retained):
#   1. APOLLO_API_KEY with enough credits: sourcing + org-enrich are cheap, but
#      each revealed email costs ~1 credit; set enrichment limits deliberately.
#   2. One mailbox per active brand below (FROM_EMAIL + SMTP_HOST minimum).
#   3. COMPLIANCE_ADDRESS set (daemon --live refuses to send without it).
#   4. SPF + DMARC + MX configured on every sending domain — `daemon --live`
#      health-checks each domain and refuses to send from a mis-authed one.
#   5. Warm mailboxes: new domains ramp their daily cap over the first ~3 weeks
#      (see warmup ramp), so plan the 5k-send campaign to fill in over time.

# Required only for real account/person sourcing and contact enrichment.
APOLLO_API_KEY=
# Required only with `enrich --phone`; Apollo posts phone results asynchronously.
APOLLO_WEBHOOK_URL=

# Optional for broad web opportunity search. Official configured catalog/program
# pages are still read without it; the Jina search source is skipped when unset.
JINA_API_KEY=

# Configure one mailbox per active brand. Mailbox caps are an additional
# deliverability rail; the business-wide 30-touch limit and timezone policy live
# in businesses/<brand>.toml and do not increase when another mailbox is added.
GNK_FROM_NAME=Andrew
GNK_FROM_EMAIL=
GNK_SMTP_HOST=
GNK_SMTP_PORT=587
GNK_SMTP_USER=
GNK_SMTP_PASS=
GNK_IMAP_HOST=
GNK_IMAP_PORT=993
GNK_DAILY_CAP=30

# Wapahki (robotic packing cell) sends from its own domain/mailbox so its
# reputation is isolated from GnK and OutageHub. Required to run the Wapahki brand.
WAPAHKI_FROM_NAME=Andrew
WAPAHKI_FROM_EMAIL=
WAPAHKI_SMTP_HOST=
WAPAHKI_SMTP_PORT=587
WAPAHKI_SMTP_USER=
WAPAHKI_SMTP_PASS=
WAPAHKI_IMAP_HOST=
WAPAHKI_IMAP_PORT=993
WAPAHKI_DAILY_CAP=30

# OutageHub funding outreach uses its own mailbox and suppression/cap state.
OUTAGEHUB_FROM_NAME=Andrew
OUTAGEHUB_FROM_EMAIL=
OUTAGEHUB_SMTP_HOST=
OUTAGEHUB_SMTP_PORT=587
OUTAGEHUB_SMTP_USER=
OUTAGEHUB_SMTP_PASS=
OUTAGEHUB_IMAP_HOST=
OUTAGEHUB_IMAP_PORT=993
OUTAGEHUB_DAILY_CAP=30

# Required before `daemon --live`; dry-run mode sends nothing.
COMPLIANCE_ADDRESS=

# Optional delay between sends.
CADENCE_SEND_DELAY_MS=1500

# TEST GUARDRAIL. When set to a comma-separated list of full addresses and/or
# `@domain` suffixes, a LIVE send is refused for any recipient not on the list —
# so `daemon --live` can be exercised end-to-end against mailboxes you own with
# zero risk of mailing a real prospect. Leave UNSET in production (empty = no
# restriction). Enforced in the SMTP transport, so nothing outbound bypasses it.
# SPRUCE_SEND_ALLOWLIST=me@mytestdomain.com,@mytestdomain.com

# Optional discovery-autopilot funnel targets. `daemon --autopilot` sources,
# enriches, and drafts toward these values without sending. Add `--live` only
# when mailbox delivery is intentionally enabled. Cold drafts still require
# `approve`, so enabling the supervisor does not silently authorize cold email.
AUTOPILOT_MIN_LEADS=25
AUTOPILOT_MIN_VERIFIED=40
AUTOPILOT_MIN_CONTACTED=25

# Google OAuth (Desktop app client). Used by:
#   - /login <brand>  → browser Gmail link per brand (gnk / wapahki / outagehub)
#   - Google Calendar booking (optional refresh token below)
# Create a Desktop OAuth client in Google Cloud, enable Gmail API (+ Calendar if
# booking), add redirect URI http://127.0.0.1  (loopback). You do NOT need Gmail
# App Passwords or IMAP toggles — just sign in when the browser opens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pre-issued refresh token for Calendar-only setups. Gmail /login
# stores per-brand refresh tokens under .spruce/google/<brand>.json instead.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=

GNK_GOOGLE_CALENDAR_ID=
GNK_MEETING_TIMEZONE=Europe/London
GNK_MEETING_DURATION_MINUTES=30
GNK_MEETING_HOURS=9,11,14

WAPAHKI_GOOGLE_CALENDAR_ID=
WAPAHKI_MEETING_TIMEZONE=America/Toronto
WAPAHKI_MEETING_DURATION_MINUTES=30
WAPAHKI_MEETING_HOURS=9,11,14

OUTAGEHUB_GOOGLE_CALENDAR_ID=
OUTAGEHUB_MEETING_TIMEZONE=America/Toronto
OUTAGEHUB_MEETING_DURATION_MINUTES=30
OUTAGEHUB_MEETING_HOURS=9,11,14
# Codex is the default backend. Terra is the economical substantive lane; Luna
# handles lightweight routing, extraction, and website research. Every Codex
# invocation pins its effort so a global CLI setting cannot silently raise use.
SPRUCE_CODEX_MODEL=gpt-5.6-terra
SPRUCE_CODEX_FAST_MODEL=gpt-5.6-luna
SPRUCE_CODEX_REASONING_EFFORT=low
SPRUCE_CODEX_FAST_REASONING_EFFORT=low
SPRUCE_CODEX_STRATEGY_REASONING_EFFORT=medium
SPRUCE_CODEX_WRITER_REASONING_EFFORT=medium
SPRUCE_CODEX_EDITOR_REASONING_EFFORT=low
SPRUCE_CODEX_VERIFIER_REASONING_EFFORT=medium
# Fold outreach angle selection into the writer to save one model call per
# recipient. Set to 0 to restore the separate, higher-quality planner call.
SPRUCE_FOLD_OUTREACH_PLANNER=1

# Other optional fast models. OpenAI defaults to Luna; Claude defaults to the
# stable `haiku` alias. Grok keeps its selected model.
# SPRUCE_CLAUDE_FAST_MODEL=haiku
# SPRUCE_GROK_FAST_MODEL=
# Metadata-only per-call usage ledger (prompts and outputs are never written).
# SPRUCE_USAGE_LOG=.spruce/model-usage.jsonl
