# Bare-metal (no Docker) alternative to docker-compose.yml.
#
# Install:
#   sudo useradd -r -m -d /home/spruce spruce           # service user with a home for ~/.claude
#   sudo mkdir -p /opt/spruce-leaf/.spruce
#   sudo cp target/release/spruce-leaf /usr/local/bin/   # or build on the box
#   sudo cp -r playbooks businesses .env /opt/spruce-leaf/
#   sudo chown -R spruce:spruce /opt/spruce-leaf /home/spruce
#   # put OPENAI_API_KEY and mailbox credentials in .env (see deploy/README.md)
#   sudo cp deploy/systemd/spruce-leaf.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now spruce-leaf
#   journalctl -u spruce-leaf -f

[Unit]
Description=spruce-leaf outreach daemon (approved live send + inbox poll)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spruce
WorkingDirectory=/opt/spruce-leaf
EnvironmentFile=/opt/spruce-leaf/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/spruce-leaf daemon --live --batch 90
Restart=on-failure
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
